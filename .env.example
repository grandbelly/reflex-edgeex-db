# ============================================================
# .env.example — copy to .env and fill real values
#   cp .env.example .env
#   nano .env   # fill in CHANGE_ME placeholders
#
# .env is gitignored; NEVER commit it.
# Compose v2 auto-loads .env from this directory for all
# docker-compose*.yml files. No --env-file flag needed.
# ============================================================

# ============================================================
# Local TimescaleDB (the pgai container we run)
# Used by docker-compose.yml, docker-compose.local.yml, docker-compose.dev.yml
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# NOTE: POSTGRES_DB=postgres is the bootstrap DB created by image init.
# The application DB 'ecoanp' is created later by init scripts.
# Do NOT change this to 'ecoanp' — it would break init behavior.
POSTGRES_DB=postgres

# ============================================================
# Composed DSN — consumed by app + scheduler containers
# Match this to POSTGRES_PASSWORD above. Host differs prod vs local:
#   prod (docker-compose.yml):       rpi-finished-pgai-db
#   local (docker-compose.local.yml): ksys-dev-db
#
# NOTE: TS_DSN and POSTGRES_CONNECTION_STRING MUST be identical.
# Two separate vars exist because different parts of the codebase
# read different env names — keep them in sync when changing.
# ============================================================
TS_DSN=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@rpi-finished-pgai-db:5432/ecoanp?sslmode=disable
POSTGRES_CONNECTION_STRING=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@rpi-finished-pgai-db:5432/ecoanp?sslmode=disable
# TS_DSN_LOCAL: used by docker-compose.local.yml (dev validation stack).
# If your DB runs on Windows host (not in docker), replace ksys-dev-db with host.docker.internal.
TS_DSN_LOCAL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@ksys-dev-db:5432/ecoanp?sslmode=disable

# ============================================================
# Ports — override per-RPI if multiple devices share LAN router
# ============================================================
FRONTEND_PORT=14000
BACKEND_PORT=14001
DB_PORT_HOST=5432

# ============================================================
# Upstream IoT Cloud DB (read-only source for tag sync)
# Used by ksys_app/states/sync_monitor_state.py
#
# DO NOT reuse the legacy exaxt00 password — that one was
# committed in plaintext to git history pre-2026-05-27.
# Request rotated credentials from the upstream data team.
# ============================================================
UPSTREAM_DB_HOST=
UPSTREAM_DB_PORT=9543
UPSTREAM_DB_NAME=iot_cloud_v2_exaxt_stp
UPSTREAM_DB_USER=
UPSTREAM_DB_PASSWORD=

# ============================================================
# Cloudflare Tunnel
#
# Get a fresh token from Cloudflare Zero Trust dashboard:
#   Networks > Tunnels > <your tunnel> > Refresh token
#
# The old token (eyJhIjoiMDQwMzY4...) is in git history.
# Externalizing alone does NOT invalidate it. ROTATE FIRST.
# Tunnel UUID stays the same — DNS records remain valid.
# ============================================================
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================================
# Vendor API keys (leave blank if unused)
# ============================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
INFLUX_TOKEN=

# ============================================================
# Runtime config (non-secret, here for convenience)
# ============================================================
TZ=Asia/Seoul
APP_ENV=production
VERSION_TYPE=FULL
ENABLE_AI_FEATURES=true
API_URL=http://localhost:14001

# ============================================================
# RPI identity — set per device
# Used for log labels, metrics, sensor mapping
# ============================================================
RPI_NODE_ID=poongdo-01
